rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userID} {
      // Account records predate UID-keyed documents, so keep their existing
      // authenticated policy separate from gameplay statistics.
      allow read, write: if request.auth != null;
    }
    match /designPreferences/{userID} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userID;
    }
    match /rooms/{roomID} {
      allow read: if request.auth != null;
      // Completed-room statistics are derived by the Admin SDK route only.
      allow write: if false;
    }
    match /reactionRankings/{rankingID} {
      allow read: if true;
      // Public ranking entries are derived by the Admin SDK route only.
      allow write: if false;
    }
  }
}
